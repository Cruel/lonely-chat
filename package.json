{
  "name": "lonely-chat",
  "productName": "Lonely Chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vp build",
    "build:electron": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:overlay": "node scripts/test-overlay.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:overlay",
    "stage:llama": "node scripts/stage-llama.mjs",
    "stage:whisper": "node scripts/stage-whisper.mjs",
    "smoke:whisper": "node scripts/smoke-whisper.mjs",
    "smoke:llama": "node scripts/smoke-llama.mjs",
    "package:linux": "node scripts/stage-llama.mjs linux-x64 && node scripts/stage-whisper.mjs linux-x64 && pnpm build && electron-builder --linux",
    "package:windows": "node scripts/stage-llama.mjs win32-x64 && node scripts/stage-whisper.mjs win32-x64 && pnpm build && electron-builder --win",
    "package:mac": "node scripts/stage-llama.mjs darwin-arm64 && node scripts/stage-whisper.mjs darwin-arm64 && pnpm build && electron-builder --mac --arm64",
    "smoke:electron": "pnpm build && node scripts/smoke-electron.mjs",
    "certify:package": "node scripts/certify-package.mjs",
    "format": "vp fmt src scripts vite.config.ts --write",
    "format:check": "vp fmt src scripts vite.config.ts --check",
    "lint": "vp lint src scripts vite.config.ts"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "jsdom": "27.0.1",
    "lucide-react": "0.468.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "description": "Offline-first simulated audience chat and local browser overlay"
}
