    <path d="M9 14c0-2.9 1.1-4.6 3-4.6s3 1.7 3 4.6c0 2.8-1.2 4.5-3 4.5S9 16.8 9 14Z" fill="#1b1826"/>
    <path d="M10.3 8.7 12 10l1.7-1.3-1.7-.9-1.7.9Z" fill="#e7bd81"/>
    <path d="M8.2 19.1 5.7 21M15.8 19.1l2.5 1.9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
