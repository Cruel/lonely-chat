---
import { PLATFORMS } from '../lib/downloads.mjs';
import PlatformIcon from './PlatformIcon.astro';
interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
---
<a class={`button button-primary ${className}`} href="/download" data-auto-download>
  {PLATFORMS.map((platform) => (
    <span class="button-platform-icon" data-download-icon={platform.id} hidden>
      <PlatformIcon platform={platform.id} />
    </span>
  ))}
  <span class="button-platform-icon" data-download-icon="generic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M12 4v12m0 0 5-5m-5 5-5-5M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
  <span data-download-label>Download</span>
</a>
